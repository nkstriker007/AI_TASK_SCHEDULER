diff --git a/scheduler/tests/test_sim.cpp b/scheduler/tests/test_sim.cpp
new file mode 100644
index 0000000..a531f20
--- /dev/null
+++ b/scheduler/tests/test_sim.cpp
@@ -0,0 +1,240 @@
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <random>
+#include <string>
+
+#include "Helpers.hpp"
+#include "ats/Simulator.hpp"
+
+using namespace ats;
+using namespace ats::test;
+using nlohmann::json;
+using ::testing::DoubleEq;
+using ::testing::ElementsAre;
+
+namespace {
+
+json timed(const std::string& id, double seconds, std::vector<std::string> deps = {}) {
+  json t = task(id, std::move(deps));
+  t["hints"] = {{"estimated_seconds", seconds}};
+  return t;
+}
+
+const SimTaskResult& result(const SimResult& r, const std::string& id) {
+  auto it = std::find_if(r.tasks.begin(), r.tasks.end(), [&](const SimTaskResult& t) { return t.id == id; });
+  if (it == r.tasks.end()) throw std::runtime_error("no task " + id);
+  return *it;
+}
+
+SimOptions withWorkers(int n, Policy p = Policy::CriticalPath) {
+  SimOptions o;
+  o.workers = n;
+  o.policy = p;
+  return o;
+}
+
+// Largest number of attempts running at the same simulated instant.
+int peakConcurrency(const SimResult& r) {
+  std::vector<std::pair<double, int>> edges;  // (time, +1 start / -1 end); ends sort before starts
+  for (const auto& e : r.events) {
+    if (e.event == "dispatched") edges.push_back({e.t, +1});
+    if (e.event == "completed" || e.event == "retrying" || e.event == "failed") edges.push_back({e.t, -1});
+  }
+  std::sort(edges.begin(), edges.end());
+  int now = 0, peak = 0;
+  for (auto [t, d] : edges) peak = std::max(peak, now += d);
+  return peak;
+}
+
+}  // namespace
+
+TEST(Simulator, ChainRunsInOrderAndTakesTheSumOfDurations) {
+  Dag g = mustBuild(planFile({timed("t1", 2), timed("t2", 3, {"t1"}), timed("t3", 4, {"t2"})}));
+  SimResult r = Simulator::run(g, withWorkers(4));
+  EXPECT_TRUE(r.succeeded);
+  EXPECT_THAT(r.makespan, DoubleEq(9));
+  EXPECT_THAT(result(r, "t2").start, DoubleEq(2));
+  EXPECT_THAT(result(r, "t3").start, DoubleEq(5));
+}
+
+TEST(Simulator, IndependentTasksRunInParallel) {
+  Dag g = mustBuild(planFile({timed("t1", 5), timed("t2", 7), timed("t3", 3), timed("t4", 1, {"t1", "t2", "t3"})}));
+  SimResult r = Simulator::run(g, withWorkers(3));
+  EXPECT_THAT(r.makespan, DoubleEq(8));  // max(5, 7, 3) + 1
+  EXPECT_EQ(peakConcurrency(r), 3);
+}
+
+TEST(Simulator, NeverRunsMoreTasksThanWorkers) {
+  Dag g = mustBuild(planFile({timed("t1", 2), timed("t2", 2), timed("t3", 2), timed("t4", 2)}));
+  SimResult r = Simulator::run(g, withWorkers(1));
+  EXPECT_THAT(r.makespan, DoubleEq(8));
+  EXPECT_EQ(peakConcurrency(r), 1);
+}
+
+TEST(Simulator, ChildStartsOnlyAfterEveryParentCompleted) {
+  Dag g = mustBuild(planFile({timed("t1", 1), timed("t2", 6), timed("t3", 1, {"t1", "t2"})}));
+  SimResult r = Simulator::run(g, withWorkers(4));
+  EXPECT_THAT(result(r, "t3").start, DoubleEq(6));
+}
+
+TEST(Simulator, MissingEstimateUsesDefaultSeconds) {
+  Dag g = mustBuild(planFile({task("t1"), task("t2", {"t1"})}));
+  SimOptions o = withWorkers(2);
+  o.defaultSeconds = 2.5;
+  EXPECT_THAT(Simulator::run(g, o).makespan, DoubleEq(5));
+}
+
+TEST(Simulator, CriticalPathBeatsFifoWhenTheLongChainIsListedLast) {
+  // Two workers. FIFO starts the three short roots first and reaches the long chain late.
+  Dag g = mustBuild(planFile({timed("t1", 1), timed("t2", 1), timed("t3", 1), timed("t4", 1),
+                              timed("t5", 10, {"t4"})}));
+  SimResult fifo = Simulator::run(g, withWorkers(2, Policy::Fifo));
+  SimResult cp = Simulator::run(g, withWorkers(2, Policy::CriticalPath));
+  EXPECT_THAT(fifo.makespan, DoubleEq(12));
+  EXPECT_THAT(cp.makespan, DoubleEq(11));
+  EXPECT_THAT(result(cp, "t4").start, DoubleEq(0));
+}
+
+TEST(Simulator, FifoTakesTasksInTheOrderTheyBecameReady) {
+  Dag g = mustBuild(planFile({timed("t1", 1), timed("t2", 1), timed("t3", 1)}));
+  SimResult r = Simulator::run(g, withWorkers(1, Policy::Fifo));
+  std::vector<std::string> order;
+  for (const auto& e : r.events)
+    if (e.event == "dispatched") order.push_back(e.taskId);
+  EXPECT_THAT(order, ElementsAre("t1", "t2", "t3"));
+}
+
+TEST(Simulator, CriticalPathRankIsLongestRemainingChain) {
+  Dag g = mustBuild(planFile({timed("t1", 1), timed("t2", 4, {"t1"}), timed("t3", 2, {"t1"}), timed("t4", 3, {"t2", "t3"})}));
+  std::vector<double> rank = criticalPathRank(g, 5);
+  EXPECT_THAT(rank[node(g, "t4")], DoubleEq(3));
+  EXPECT_THAT(rank[node(g, "t2")], DoubleEq(7));
+  EXPECT_THAT(rank[node(g, "t3")], DoubleEq(5));
+  EXPECT_THAT(rank[node(g, "t1")], DoubleEq(8));
+}
+
+TEST(Simulator, RetriesWithExponentialBackoffThenSucceeds) {
+  Dag g = mustBuild(planFile({timed("t1", 1)}));
+  SimOptions o = withWorkers(1);
+  o.failFirst["t1"] = 2;
+  o.maxAttempts = 3;
+  o.backoffSeconds = 1;
+  SimResult r = Simulator::run(g, o);
+  EXPECT_TRUE(r.succeeded);
+  EXPECT_EQ(result(r, "t1").attempts, 3);
+  EXPECT_EQ(r.retries, 2u);
+  // attempt 1: 0-1, wait 1, attempt 2: 2-3, wait 2, attempt 3: 5-6
+  EXPECT_THAT(result(r, "t1").start, DoubleEq(5));
+  EXPECT_THAT(r.makespan, DoubleEq(6));
+}
+
+TEST(Simulator, AWorkerIsFreeDuringBackoff) {
+  Dag g = mustBuild(planFile({timed("t1", 1), timed("t2", 1)}));
+  SimOptions o = withWorkers(1);
+  o.failFirst["t1"] = 1;
+  o.backoffSeconds = 10;
+  SimResult r = Simulator::run(g, o);
+  EXPECT_THAT(result(r, "t2").start, DoubleEq(1));   // runs while t1 waits
+  EXPECT_THAT(result(r, "t1").start, DoubleEq(11));
+}
+
+TEST(Simulator, ExhaustedRetriesFailTheTaskAndCancelOnlyItsDescendants) {
+  Dag g = mustBuild(planFile({timed("t1", 1), timed("t2", 1, {"t1"}), timed("t3", 1, {"t2"}),
+                              timed("t4", 1), timed("t5", 1, {"t4"})}));
+  SimOptions o = withWorkers(2);
+  o.failFirst["t1"] = 99;
+  o.maxAttempts = 2;
+  SimResult r = Simulator::run(g, o);
+  EXPECT_FALSE(r.succeeded);
+  EXPECT_EQ(result(r, "t1").state, TaskState::Failed);
+  EXPECT_EQ(result(r, "t1").attempts, 2);
+  EXPECT_EQ(result(r, "t2").state, TaskState::Cancelled);
+  EXPECT_EQ(result(r, "t3").state, TaskState::Cancelled);
+  EXPECT_EQ(result(r, "t5").state, TaskState::Completed);
+  EXPECT_EQ(result(r, "t2").attempts, 0);   // never dispatched
+}
+
+TEST(Simulator, SameSeedGivesTheSameRun) {
+  Dag g = mustBuild(planFile({timed("t1", 1), timed("t2", 2), timed("t3", 1, {"t1", "t2"}), timed("t4", 3, {"t3"})}));
+  SimOptions o = withWorkers(2);
+  o.failRate = 0.5;
+  o.seed = 42;
+  SimResult a = Simulator::run(g, o), b = Simulator::run(g, o);
+  ASSERT_EQ(a.events.size(), b.events.size());
+  for (std::size_t i = 0; i < a.events.size(); ++i) {
+    EXPECT_EQ(a.events[i].taskId, b.events[i].taskId);
+    EXPECT_EQ(a.events[i].event, b.events[i].event);
+    EXPECT_THAT(a.events[i].t, DoubleEq(b.events[i].t));
+  }
+}
+
+TEST(Simulator, RejectsBadOptions) {
+  Dag g = mustBuild(planFile({task("t1")}));
+  SimOptions o;
+  o.workers = 0;
+  EXPECT_THROW(Simulator::run(g, o), std::invalid_argument);
+  o = SimOptions{};
+  o.maxAttempts = 0;
+  EXPECT_THROW(Simulator::run(g, o), std::invalid_argument);
+}
+
+TEST(Simulator, EveryValidFixtureRunsToCompletion) {
+  std::ifstream in(ATS_EXPECTED_VALIDATION);
+  json expected = json::parse(in);
+  int checked = 0;
+  for (const auto& [name, exp] : expected.items()) {
+    if (!exp.at("valid").get<bool>()) continue;
+    LoadResult l = loadPlanFile(std::filesystem::path(ATS_FIXTURES_DIR) / (name + ".json"));
+    ASSERT_TRUE(l.ok()) << name;
+    Dag::BuildResult b = Dag::build(*l.plan);
+    ASSERT_TRUE(b.dag) << name;
+    for (Policy p : {Policy::Fifo, Policy::CriticalPath}) {
+      SimResult r = Simulator::run(*b.dag, withWorkers(2, p));
+      EXPECT_TRUE(r.succeeded) << name;
+      EXPECT_LE(peakConcurrency(r), 2) << name;
+    }
+    ++checked;
+  }
+  EXPECT_GE(checked, 7);
+}
+
+// Property test: random DAGs, worker counts and failure rates. Whatever happens, the run
+// ends with every task terminal, never exceeds the worker count, never starts a task before
+// all its parents completed.
+TEST(Simulator, RandomPlansKeepEveryInvariant) {
+  std::mt19937 rng(7);
+  for (int round = 0; round < 300; ++round) {
+    int n = std::uniform_int_distribution<int>(1, 25)(rng);
+    json tasks = json::array();
+    for (int i = 1; i <= n; ++i) {
+      std::vector<std::string> deps;
+      for (int j = 1; j < i; ++j)
+        if (std::bernoulli_distribution(0.2)(rng)) deps.push_back("t" + std::to_string(j));
+      tasks.push_back(timed("t" + std::to_string(i), std::uniform_int_distribution<int>(0, 9)(rng), deps));
+    }
+    Dag g = mustBuild(planFile(tasks));
+    SimOptions o = withWorkers(std::uniform_int_distribution<int>(1, 5)(rng),
+                               round % 2 ? Policy::Fifo : Policy::CriticalPath);
+    o.failRate = std::uniform_real_distribution<double>(0, 0.5)(rng);
+    o.maxAttempts = std::uniform_int_distribution<int>(1, 3)(rng);
+    o.seed = static_cast<std::uint64_t>(round);
+    SimResult r = Simulator::run(g, o);
+
+    ASSERT_LE(peakConcurrency(r), o.workers) << "round " << round;
+    bool allCompleted = true;
+    for (NodeId v = 0; v < g.size(); ++v) {
+      const SimTaskResult& t = r.tasks[v];
+      ASSERT_TRUE(isTerminal(t.state)) << "round " << round;
+      allCompleted = allCompleted && t.state == TaskState::Completed;
+      if (t.start >= 0) {
+        for (NodeId p : g.parents(v)) {
+          ASSERT_EQ(r.tasks[p].state, TaskState::Completed) << "round " << round;
+          ASSERT_LE(r.tasks[p].end, t.start) << "round " << round;
+        }
+      }
+    }
+    ASSERT_EQ(r.succeeded, allCompleted) << "round " << round;
+  }
+}
diff --git a/scheduler/tools/ats_sim.cpp b/scheduler/tools/ats_sim.cpp
new file mode 100644
index 0000000..25049f9
--- /dev/null
+++ b/scheduler/tools/ats_sim.cpp
@@ -0,0 +1,216 @@
+// ats_sim <plan.json> [options]
+// Validates a plan file (PlanLoader + Dag::build), then runs it in the simulator.
+//
+//   --json                 machine-readable output (contract #1, "ats_sim expectations")
+//   --workers N            simulated workers (default 4)
+//   --policy P             fifo | critical (default critical)
+//   --max-attempts N       attempts per task incl. the first (default 3)
+//   --default-seconds S    duration when a task has no estimated_seconds (default 5)
+//   --backoff S            first retry wait in seconds, doubled each retry (default 1)
+//   --fail ID:N            task ID fails its first N attempts (repeatable)
+//   --fail-rate P          every attempt fails with probability P (default 0)
+//   --seed N               random seed for --fail-rate (default 1)
+//
+// Exit codes (contract #1): 0 plan valid and every task completed, 1 plan invalid,
+// 2 plan valid but execution failed, 64 usage error.
+#include <algorithm>
+#include <charconv>
+#include <cstdio>
+#include <iomanip>
+#include <iostream>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <string_view>
+#include <type_traits>
+#include <vector>
+
+#include <nlohmann/json.hpp>
+
+#include "ats/Dag.hpp"
+#include "ats/PlanLoader.hpp"
+#include "ats/Simulator.hpp"
+
+namespace {
+
+constexpr int kExitOk = 0;
+constexpr int kExitInvalid = 1;
+constexpr int kExitFailed = 2;
+constexpr int kExitUsage = 64;
+
+int usage(const std::string& why) {
+  std::cerr << "ats_sim: " << why << "\n"
+            << "usage: ats_sim <plan.json> [--json] [--workers N] [--policy fifo|critical]\n"
+            << "               [--max-attempts N] [--default-seconds S] [--backoff S]\n"
+            << "               [--fail ID:N]... [--fail-rate P] [--seed N]\n";
+  return kExitUsage;
+}
+
+template <typename T>
+bool parseNum(std::string_view s, T& out) {
+  if constexpr (std::is_floating_point_v<T>) {
+    try {
+      std::size_t used = 0;
+      out = static_cast<T>(std::stod(std::string(s), &used));
+      return used == s.size();
+    } catch (...) {
+      return false;
+    }
+  } else {
+    auto [p, ec] = std::from_chars(s.data(), s.data() + s.size(), out);
+    return ec == std::errc() && p == s.data() + s.size();
+  }
+}
+
+std::string fmt(double v) {
+  std::ostringstream o;
+  o << std::fixed << std::setprecision(1) << v;
+  return o.str();
+}
+
+nlohmann::json issuesJson(const std::vector<ats::ValidationIssue>& v) {
+  nlohmann::json a = nlohmann::json::array();
+  for (const auto& i : v) a.push_back({{"code", i.code}, {"task_id", i.taskId}, {"message", i.message}});
+  return a;
+}
+
+void printHuman(const ats::Dag& dag, const ats::SimOptions& o, const ats::SimResult& r) {
+  std::cout << "request " << dag.requestId() << ": " << dag.size() << " tasks, " << o.workers
+            << " workers, policy " << ats::toString(o.policy) << "\n\n";
+  for (const auto& e : r.events) {
+    std::cout << "[" << std::setw(7) << fmt(e.t) << "s] " << std::left << std::setw(11) << e.event
+              << std::right << std::setw(6) << e.taskId;
+    if (e.attempt > 0) std::cout << "  attempt " << e.attempt;
+    if (e.worker >= 0) std::cout << "  worker " << e.worker;
+    std::cout << "\n";
+  }
+
+  // Text timeline, one row per task (last attempt only).
+  constexpr int kWidth = 50;
+  double total = r.makespan > 0 ? r.makespan : 1.0;
+  std::cout << "\n";
+  for (const auto& t : r.tasks) {
+    std::string bar(kWidth, ' ');
+    if (t.start >= 0 && t.end >= 0) {
+      int a = static_cast<int>(t.start / total * kWidth);
+      int b = std::max(a + 1, static_cast<int>(t.end / total * kWidth));
+      char c = t.state == ats::TaskState::Completed ? '#' : 'x';
+      for (int i = a; i < b && i < kWidth; ++i) bar[static_cast<std::size_t>(i)] = c;
+    }
+    std::cout << std::left << std::setw(6) << t.id << std::right << " |" << bar << "| "
+              << ats::toString(t.state);
+    if (t.attempts > 1) std::cout << " after " << t.attempts << " attempts";
+    std::cout << "\n";
+  }
+  std::cout << "\n"
+            << (r.succeeded ? "succeeded" : "FAILED") << ": makespan " << fmt(r.makespan) << "s, "
+            << r.retries << " retries\n";
+}
+
+nlohmann::json resultJson(const ats::Dag& dag, const ats::SimOptions& o, const ats::SimResult& r) {
+  nlohmann::json tasks = nlohmann::json::array();
+  for (const auto& t : r.tasks) {
+    tasks.push_back({{"id", t.id}, {"state", ats::toString(t.state)}, {"attempts", t.attempts},
+                     {"start", t.start}, {"end", t.end}, {"worker", t.worker}});
+  }
+  nlohmann::json events = nlohmann::json::array();
+  for (const auto& e : r.events) {
+    events.push_back({{"t", e.t}, {"task_id", e.taskId}, {"event", e.event},
+                      {"attempt", e.attempt}, {"worker", e.worker}});
+  }
+  return {{"valid", true},
+          {"request_id", dag.requestId()},
+          {"issues", nlohmann::json::array()},
+          {"workers", o.workers},
+          {"policy", ats::toString(o.policy)},
+          {"succeeded", r.succeeded},
+          {"makespan_s", r.makespan},
+          {"retries", r.retries},
+          {"tasks", tasks},
+          {"events", events}};
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string path;
+  bool json = false;
+  ats::SimOptions opts;
+
+  for (int i = 1; i < argc; ++i) {
+    std::string_view a = argv[i];
+    auto value = [&](std::string_view& out) {
+      if (i + 1 >= argc) return false;
+      out = argv[++i];
+      return true;
+    };
+    std::string_view v;
+    if (a == "--json") {
+      json = true;
+    } else if (a == "--workers") {
+      if (!value(v) || !parseNum(v, opts.workers) || opts.workers < 1) return usage("--workers needs an integer >= 1");
+    } else if (a == "--policy") {
+      if (!value(v)) return usage("--policy needs fifo or critical");
+      auto p = ats::parsePolicy(v);
+      if (!p) return usage("unknown policy '" + std::string(v) + "'");
+      opts.policy = *p;
+    } else if (a == "--max-attempts") {
+      if (!value(v) || !parseNum(v, opts.maxAttempts) || opts.maxAttempts < 1) return usage("--max-attempts needs an integer >= 1");
+    } else if (a == "--default-seconds") {
+      if (!value(v) || !parseNum(v, opts.defaultSeconds) || opts.defaultSeconds < 0) return usage("--default-seconds needs a number >= 0");
+    } else if (a == "--backoff") {
+      if (!value(v) || !parseNum(v, opts.backoffSeconds) || opts.backoffSeconds < 0) return usage("--backoff needs a number >= 0");
+    } else if (a == "--fail-rate") {
+      if (!value(v) || !parseNum(v, opts.failRate) || opts.failRate < 0 || opts.failRate > 1) return usage("--fail-rate needs a number in [0, 1]");
+    } else if (a == "--seed") {
+      if (!value(v) || !parseNum(v, opts.seed)) return usage("--seed needs a non-negative integer");
+    } else if (a == "--fail") {
+      if (!value(v)) return usage("--fail needs ID:N");
+      auto colon = v.rfind(':');
+      int n = 0;
+      if (colon == std::string_view::npos || colon == 0 || !parseNum(v.substr(colon + 1), n) || n < 1)
+        return usage("--fail needs ID:N with N >= 1, e.g. --fail t3:2");
+      opts.failFirst[std::string(v.substr(0, colon))] = n;
+    } else if (!a.empty() && a.front() == '-') {
+      return usage("unknown option " + std::string(a));
+    } else if (path.empty()) {
+      path = a;
+    } else {
+      return usage("only one plan file");
+    }
+  }
+  if (path.empty()) return usage("missing plan file");
+
+  // 1. Validate exactly like ats_validate: schema first, then structure.
+  ats::LoadResult loaded = ats::loadPlanFile(path);
+  std::vector<ats::ValidationIssue> issues = loaded.issues;
+  std::optional<ats::Dag> dag;
+  if (loaded.ok()) {
+    ats::Dag::BuildResult built = ats::Dag::build(*loaded.plan);
+    issues.insert(issues.end(), built.issues.begin(), built.issues.end());
+    dag = std::move(built.dag);
+  }
+  if (!issues.empty() || !dag) {
+    if (json) {
+      std::cout << nlohmann::json{{"valid", false}, {"issues", issuesJson(issues)}}.dump(2) << "\n";
+    } else {
+      std::cout << "plan rejected (" << issues.size() << " issue" << (issues.size() == 1 ? "" : "s") << "):\n";
+      for (const auto& i : issues)
+        std::cout << "  " << i.code << (i.taskId.empty() ? "" : " [" + i.taskId + "]") << ": " << i.message << "\n";
+    }
+    return kExitInvalid;
+  }
+
+  for (const auto& [id, n] : opts.failFirst) {
+    if (!dag->find(id)) return usage("--fail names unknown task '" + id + "'");
+  }
+
+  // 2. Run it.
+  ats::SimResult result = ats::Simulator::run(*dag, opts);
+  if (json) {
+    std::cout << resultJson(*dag, opts, result).dump(2) << "\n";
+  } else {
+    printHuman(*dag, opts, result);
+  }
+  return result.succeeded ? kExitOk : kExitFailed;
+}
